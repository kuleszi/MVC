@model IEnumerable<CookBook.Models.Recipe>
@section Scripts {
    <script src="~/js/myrecipe.js"></script>
}

<h1>Moje przepisy</h1>
<div id="deleteBanner" class="alert alert-warning d-none position-fixed top-0 start-50 translate-middle-x mt-3"
     style="z-index: 1050; min-width: 300px; box-shadow: 0px 4px 15px rgba(0,0,0,0.2);">
    <p id="deleteMessage" class="mb-2 fw-bold text-center">Czy na pewno chcesz usunąć ten przepis?</p>
    <div id="bannerButtons" class="text-center">
        <button id="confirmDeleteBtn" class="btn btn-danger btn-sm me-2">Tak</button>
        <button id="cancelDeleteBtn" class="btn btn-secondary btn-sm">Nie</button>
    </div>
</div>
<table class="table table-striped table-hover align-middle shadow-sm rounded">
    <thead>
        <tr>
            <th>Nazwa przepisu</th>
            <th>Kategoria</th>
            <th>Data dodania</th>
            <th>Edytuj</th>
            <th>Usuń</th>
        </tr>
    </thead>
    <tbody>

        @foreach (var recipe in Model)
        {
            <tr>
                <td>@recipe.Name</td>
                <td>@recipe.Category</td>
                <td><time
                    datetime="@recipe.CreatedAt.ToString("yyyy-MM-dd")">@recipe.CreatedAt.ToString("dd.MM.yyyy")</time>
                </td>
                <td><a asp-route-id="@recipe.Id" asp-controller="Recipe" asp-action="Edit" class="EditBtn">Edytuj</a></td>
                <td><button class="btn btn-danger delete-trigger" data-id="@recipe.Id">Usuń</button></td>
            </tr>
        }
    </tbody>
</table>
<a asp-controller="Recipe" asp-action="Create" class="btn">Dodaj nowy przepis</a>