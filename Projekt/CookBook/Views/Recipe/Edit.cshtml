@model CookBook.Models.Recipe
@section Scripts {
    <script src="~/js/edit.js"></script>
}
@{
    ViewData["Title"] = "Edytuj przepis: " + Model.Name;
}

<div class="container mt-5">
    
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="d-flex justify-content-between mb-4 pb-3 border-bottom">
        <button type="submit" form="editRecipeForm" class="btn btn-success btn-lg px-4 shadow-sm">Zapisz zmiany</button>
        <form asp-controller="Recipe" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="m-0">
            <button type="button" id="deleteEditBtn" class="btn btn-danger btn-lg px-4 shadow-sm" data-id="@Model.Id">Usuń przepis</button>
        </form>
    </div>

    <form id="editRecipeForm" asp-controller="Recipe" asp-action="Edit" method="post" enctype="multipart/form-data">
        
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="UserId" />

        <div class="row gx-5 mb-5 align-items-center">
            
            <div class="col-md-6 editable-image-wrapper position-relative">
                <button type="button" class="btn-remove-image btn btn-sm btn-danger position-absolute top-0 end-0 m-3 shadow" title="Usuń zdjęcie" style="z-index: 10;">❌</button>
                <img src="/@Model.Photo" alt="@Model.Name" class="recipe-main-image img-fluid rounded w-100 shadow-sm" style="max-height: 70vh; object-fit: cover;" />
                <div class="edit-icon-overlay position-absolute top-50 start-50 translate-middle badge bg-dark opacity-75 p-3 fs-5 rounded-pill" style="cursor: pointer; z-index: 5; transition: 0.3s;">✏️ zmień zdjęcie</div>
                <input type="file" name="NewPhoto" class="d-none" accept="image/*" />
            </div>

            <div class="col-md-6 d-flex flex-column justify-content-center text-center mt-4 mt-md-0">
                
                <div class="p-4 bg-light rounded mb-4 position-relative shadow-sm border">
                    <h1 class="recipe-title edit-text m-0">@Model.Name</h1>
                    <input asp-for="Name" class="edit-input d-none form-control form-control-lg text-center fs-3" />
                    <span class="edit-icon position-absolute top-0 end-0 m-2 p-1" style="cursor: pointer;">✏️</span>
                </div>

                <div class="d-flex justify-content-center gap-4 p-4 bg-light rounded shadow-sm border">
                    <div class="stat-item position-relative d-flex align-items-center">
                        <span class="fs-6 me-2">⌚</span>
                        <span class="stat-text edit-text fs-6">@Model.CookTime</span>
                        <input asp-for="CookTime" class="edit-input d-none form-control text-center mx-2" style="width: 80px;" />
                        <span class="fs-6 ms-1">m</span>
                        <span class="edit-icon ms-2 opacity-75" style="cursor: pointer;">✏️</span>
                    </div>
                    
                    <div class="stat-item position-relative d-flex align-items-center border-start border-end px-4">
                        <span class="fs-6 me-2">🔥</span>
                        <span class="stat-text edit-text fs-6">@Model.Kcal</span>
                        <input asp-for="Kcal" class="edit-input d-none form-control text-center mx-2" style="width: 80px;" />
                        <span class="fs-6 ms-1">kcal</span>
                        <span class="edit-icon ms-2 opacity-75" style="cursor: pointer;">✏️</span>
                    </div>
                    
                    <div class="stat-item position-relative d-flex align-items-center">
                        <span class="fs-6 me-2">🍽️</span>
                        <span class="stat-text edit-text fs-6">@Model.Portion</span>
                        <input asp-for="Portion" class="edit-input d-none form-control text-center mx-2" style="width: 80px;" />
                        <span class="fs-6 ms-1">porcji</span>
                        <span class="edit-icon ms-2 opacity-75" style="cursor: pointer;">✏️</span>
                    </div>
                </div>

            </div>
        </div>

        <div class="row mb-5">
            <div class="col-12">
                <div class="p-4 border rounded shadow-lg text-center bg-light position-relative">
                    <p class="description-text edit-text m-0 fs-5">@Model.Description</p>
                    <textarea asp-for="Description" class="edit-input d-none form-control fs-5" rows="5"></textarea>
                    <span class="edit-icon position-absolute top-0 end-0 m-3 p-1" style="cursor: pointer;">✏️</span>
                </div>
            </div>
        </div>

        <div class="row gx-5 mb-5">
            
            <div class="col-md-6">
                <h3 class="text-center border-bottom pb-2 mb-4">Lista zakupów:</h3>
                
                <table class="table table-borderless align-middle ingredients-list" id="ingredientsList">
                    @if (Model.Ingredients != null)
                    {
                        for (int i = 0; i < Model.Ingredients.Count; i++)
                        {
                            <tr class="ingredient-row editable-row border-bottom">
                                <td class="d-none">
                                    <input type="hidden" asp-for="Ingredients[i].Id" />
                                </td>
                                
                                <td class="text-primary-emphasis w-50 pe-3">
                                    <span class="ingredient-name edit-text fw-semibold">@Model.Ingredients[i].Name</span>
                                    <input asp-for="Ingredients[i].Name" class="edit-input d-none form-control" placeholder="Nazwa składnika" />
                                </td>

                                <td class="text-body-secondary text-end pe-2" style="width: 20%;">
                                    <span class="ingredient-amount edit-text">@Model.Ingredients[i].Amount</span>
                                    <input asp-for="Ingredients[i].Amount" class="edit-input d-none form-control text-end" placeholder="Ilość" />
                                </td>

                                <td class="text-primary-emphasis" style="width: 30%;">
                                    <span class="ingredient-measure edit-text">@Model.Ingredients[i].Measurement</span>
                                    <select asp-for="Ingredients[i].Measurement" class="edit-input d-none form-select">
                                        <option value="g">g</option>
                                        <option value="dag">dag</option>
                                        <option value="kg">kg</option>
                                        <option value="ml">ml</option>
                                        <option value="l">l</option>
                                        <option value="szklanka">szklanka</option>
                                        <option value="łyżka">łyżka</option>
                                        <option value="łyżeczka">łyżeczka</option>
                                        <option value="szczypta">szczypta</option>
                                        <option value="sztuka">sztuka</option>
                                        <option value="do smaku">do smaku</option>
                                    </select>
                                </td>

                                <td class="text-end row-actions" style="white-space: nowrap;">
                                    <span class="edit-icon" style="cursor:pointer;" title="Edytuj">✏️</span>
                                    <span class="delete-icon ms-2" style="cursor:pointer;" title="Usuń">❌</span>
                                    <span class="addIconsIn-icon ms-2" style="cursor:pointer;" title="Dodaj pod spodem">➕</span>
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>

            <div class="col-md-6">
                <h3 class="text-center border-bottom pb-2 mb-4">Sposób przygotowania</h3>
                
                <div class="list-group list-group-flush steps-list" id="stepsList">
                    @if (Model.Steps != null)
                    {
                        for (int i = 0; i < Model.Steps.Count; i++)
                        {
                            string bgColor = (i % 2 == 0) ? "#e9ecef" : "transparent";

                            <div class="step-item editable-row list-group-item d-flex align-items-center p-3 border-0" style="background-color: @bgColor;">
                                <input type="hidden" asp-for="Steps[i].Id" />
                                
                                <div class="step-data flex-grow-1 me-3">
                                    <span class="step-desc edit-text">@Model.Steps[i].StepDescription</span>
                                    <textarea asp-for="Steps[i].StepDescription" class="edit-input d-none form-control" rows="2" placeholder="Opisz krok..."></textarea>
                                </div>

                                <div class="row-actions text-end" style="white-space: nowrap;">
                                    <span class="edit-icon" style="cursor:pointer;" title="Edytuj">✏️</span>
                                    <span class="delete-icon ms-2" style="cursor:pointer;" title="Usuń">❌</span>
                                    <span class="addIconsSt-icon ms-2" style="cursor:pointer;" title="Dodaj pod spodem">➕</span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

        </div>

        <div class="row mb-5 justify-content-center">
            <div class="col-md-6 col-lg-4 text-center">
                <div class="p-4 bg-light rounded shadow-sm border">
                    <label asp-for="CategoryId" class="form-label fs-5 fw-bold mb-3">Zmień kategorię:</label>
                    <select class="form-select form-select-lg text-center" asp-for="CategoryId"> 
                        @foreach(var category in ViewBag.Categories){
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger mt-2 d-block"></span>
                </div>
            </div>
        </div>

    </form>
</div>