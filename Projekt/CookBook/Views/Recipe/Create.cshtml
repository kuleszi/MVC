@model CookBook.Models.Recipe
@{
    ViewData["Title"] = "Dodaj nowy przepis";
}

@section Scripts {
    <script src="~/js/create.js"></script>
}

<style>
    #Ingredients input,
    #Ingredients select,
    #Steps input {
    display: block;
    width: 100%;
    padding: 0.375rem 0.75rem;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--bs-body-color);
    background-color: var(--bs-body-bg);
    border: var(--bs-border-width) solid var(--bs-border-color);
    border-radius: var(--bs-border-radius);
    transition: border-color .15s ease-in-out, box-shadow .15s ease-in-out;
    }

    #Ingredients .row,
    #Steps .row {
    margin-bottom: 0.75rem;
    align-items: center;
    }
</style>

<div class="container mt-5 mb-5">

    <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">

            <div
                class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 border-bottom pb-4">
                <h2 class="mb-3 mb-md-0 fw-bold text-primary-emphasis">Nowy przepis</h2>
                <button type="submit" form="createRecipeForm" id="AddRecipeBtn"
                        class="btn btn-success btn-lg px-5 shadow-sm">
                    Dodaj przepis
                </button>
            </div>

            <form id="createRecipeForm" asp-controller="Recipe" asp-action="Create" method="post"
                  enctype="multipart/form-data">

                <div class="row gx-4 mb-4">
                    <div class="col-md-5 mb-3 mb-md-0">
                        <label class="form-label fw-bold" asp-for="Name">Podaj nazwę przepisu:</label>
                        <input class="form-control form-control-lg" asp-for="Name" type="text"
                               placeholder="Np. Jajka w humusie" />
                        <span asp-validation-for="Name" class="invalid-feedback d-block"></span>
                    </div>

                    <div class="col-md-3 mb-3 mb-md-0">
                        <label class="form-label fw-bold" asp-for="CategoryId">Wybierz kategorię:</label>
                        <select class="form-select form-select-lg" asp-for="CategoryId">
                            <option value="">-- Wybierz --</option>
                            @if (ViewBag.Categories != null)
                            {
                                foreach (var category in ViewBag.Categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="invalid-feedback d-block"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold" for="Photo">Dodaj zdjęcie (opcjonalnie):</label>
                        <input type="file" name="Photo" id="Photo" class="form-control form-control-lg"
                               accept="image/*" />
                    </div>
                </div>

                <div class="row gx-4 mb-4 p-4 bg-light rounded shadow-sm border mx-0">
                    <div class="col-md-4 mb-3 mb-md-0">
                        <label class="form-label text-secondary fw-semibold" asp-for="CookTime">⌚ Czas przygotowania
                            (m):</label>
                            <input class="form-control text-center" asp-for="CookTime" type="number" placeholder="np. 45" />
                            <span asp-validation-for="CookTime" class="invalid-feedback d-block"></span>
                        </div>

                        <div class="col-md-4 mb-3 mb-md-0 border-md-start border-md-end">
                            <label class="form-label text-secondary fw-semibold" asp-for="Kcal">🔥 Wartość energetyczna
                                (kcal):</label>
                                <input class="form-control text-center" asp-for="Kcal" type="number" placeholder="np. 500" />
                                <span asp-validation-for="Kcal" class="invalid-feedback d-block"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label text-secondary fw-semibold" asp-for="Portion">🍽️ Liczba
                                    porcji:</label>
                                    <input class="form-control text-center" asp-for="Portion" type="number" placeholder="np. 2" />
                                    <span asp-validation-for="Portion" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                            <div class="row mb-5">
                                <div class="col-12">
                                    <label class="form-label fw-bold" asp-for="Description">Opis dania:</label>
                                    <textarea class="form-control fs-5" asp-for="Description" rows="3"
                                              placeholder="Krótko opisz co to za danie i dlaczego warto je zrobić..."></textarea>
                                    <span asp-validation-for="Description" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                            <div class="row gx-5 mt-2">

                                <div class="col-lg-6 border-end-lg mb-5 mb-lg-0 pe-lg-4">
                                    <h4 class="mb-4 text-center border-bottom pb-2">Lista zakupów</h4>

                                    <div id="Ingredients">
                                        <div class="row mb-2 align-items-center">
                                            <div class="col-5">
                                                <input name="Ingredients[0].Name" type="text" placeholder="Nazwa składnika" />
                                                <span data-valmsg-for="Ingredients[0].Name" class="text-danger small"
                                                      data-valmsg-replace="true"></span>
                                            </div>
                                            <div class="col-3">
                                                <input name="Ingredients[0].Amount" type="number" placeholder="Ilość" step="0.1" />
                                                <span data-valmsg-for="Ingredients[0].Amount" class="text-danger small"
                                                      data-valmsg-replace="true"></span>
                                            </div>
                                            <div class="col-3">
                                                <select name="Ingredients[0].Measurement">
                                                    <option>g</option>
                                                    <option>dag</option>
                                                    <option>kg</option>
                                                    <option>ml</option>
                                                    <option>l</option>
                                                    <option>szklanka</option>
                                                    <option>łyżka</option>
                                                    <option>łyżeczka</option>
                                                    <option>szczypta</option>
                                                    <option>sztuka</option>
                                                    <option>do smaku</option>
                                                </select>
                                                <span data-valmsg-for="Ingredients[0].Measurement" class="text-danger small"
                                                      data-valmsg-replace="true"></span>
                                            </div>
                                            <div class="col-1 text-end">
                                                <span style="visibility: hidden; font-size: 1.2rem;">❌</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="text-center mt-4">
                                        <button type="button" id="IngredientsBtn"
                                                class="btn btn-outline-primary fw-bold w-100 py-2">
                                            ➕ Dodaj składnik
                                        </button>
                                    </div>
                                </div>

                                <div class="col-lg-6 ps-lg-4">
                                    <h4 class="mb-4 text-center border-bottom pb-2">Sposób przygotowania</h4>

                                    <div id="Steps">
                                        <div class="row mb-2 align-items-center">
                                            <div class="col-2">
                                                <input name="Steps[0].StepNumber" type="number" placeholder="Nr" value="1" />
                                                <span data-valmsg-for="Steps[0].StepNumber" class="text-danger small"
                                                      data-valmsg-replace="true"></span>
                                            </div>
                                            <div class="col-9">
                                                <input name="Steps[0].StepDescription" type="text"
                                                       placeholder="Opisz ten krok..." />
                                                <span data-valmsg-for="Steps[0].StepDescription" class="text-danger small"
                                                      data-valmsg-replace="true"></span>
                                            </div>
                                            <div class="col-1 text-end">
                                                <span style="visibility: hidden; font-size: 1.2rem;">❌</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="text-center mt-4">
                                        <button type="button" id="StepsBtn" class="btn btn-outline-primary fw-bold w-100 py-2">
                                            ➕ Dodaj krok
                                        </button>
                                    </div>
                                </div>

                            </div>

                        </form>
                    </div>
                </div>
            </div>


