@model CookBook.Models.Recipe
@{
    ViewData["Title"] = Model.Name ?? "Przepis";
}

<div class="container mt-5">

    <div class="row gx-5 mb-5 align-items-center">
        <div class="col-md-6">
            <a asp-controller="Recipe" asp-action="Details" asp-route-id="@Model.Id">
                <img src="/@Model.Photo" alt="@Model.Name" class="img-fluid rounded w-100"
                     style="max-height: 70vh; object-fit: cover;" /></a>
            </div>

            <div class="col-md-6 d-flex flex-column justify-content-center text-center">
                <h1 class="p-3 bg-light rounded mb-4">@Model.Name</h1>

                <div class="d-flex justify-content-center gap-4 p-3 bg-light rounded">
                    <div><span class="fs-5 me-1">⌚</span> @Model.CookTime m</div>
                    <div><span class="fs-5 me-1">🔥</span> @Model.Kcal kcal</div>
                    <div><span class="fs-5 me-1">🍽️</span> @Model.Portion porcji</div>
                </div>
            </div>
        </div>

        <div class="row mb-5">
            <div class="col-12">
                <div class="p-4 border rounded shadow-lg text-center bg-light">
                    <p class="m-0 fs-5">@Model.Description</p>
                </div>
            </div>
        </div>

        <div class="row gx-5 mb-5">

            <div class="col-md-6">
                <h3 class="text-center border-bottom pb-2 mb-4">Lista zakupów:</h3>
                <ul class="list-unstyled" id="ingredientsList">
                    <table class="table table-borderless align-middle">
                        @if (Model.Ingredients != null)
                        {
                            for (int i = 0; i < Model.Ingredients.Count; i++)
                            {
                                <tr>
                                    <input type="hidden" asp-for="Ingredients[i].Id" />
                                    <td class="text-primary-emphasis">@Model.Ingredients[i].Name</td>
                                    <td class="text-body-secondary">@Model.Ingredients[i].Amount</td>
                                    <td class="text-primary-emphasis">@Model.Ingredients[i].Measurement</td>
                                </tr>
                            }
                        }
                    </table>
                </div>

                <div class="col-md-6">
                    <h3 class="text-center border-bottom pb-2 mb-4">Sposób przygotowania</h3>
                    <div class="list-group list-group-flush">
                        @if (Model.Steps != null)
                        {
                            for (int i = 0; i < Model.Steps.Count; i++)
                            {
                                @* Sprawdzamy czy i jest parzyste; jeśli tak, dajemy jaśniejszy szary *@
                                string bgColor = (i % 2 == 0) ? "#e9ecef" : "transparent";

                                <div class="list-group-item d-flex align-items-center p-3 border-0" style="background-color: @bgColor;">
                                    <input type="checkbox" class="form-check-input me-3" id="step-@i" />
                                    <label class="form-check-label" for="step-@i">
                                        @Model.Steps[i].StepDescription
                                    </label>
                                </div>
                            }
                        }
                    </div>
                    <script>
                                    document.querySelectorAll('.form-check-input').forEach(checkbox => {
                                        checkbox.addEventListener('change', function () {
                                            const label = this.nextElementSibling;
                                            if (this.checked) {
                                                label.style.textDecoration = 'line-through';
                                                label.style.color = 'gray';
                                            } else {
                                                label.style.textDecoration = 'none';
                                                label.style.color = 'inherit';
                                            }
                                        });
                                    });
                    </script>
                </div>

            </div>

            <div class="row">
                <div class="col-12 text-center mb-5">
                    <button type="button" class="btn btn-secondary px-4 py-2">
                        Wróć do @(Model.Category?.Name ?? "Kategorii")
                    </button>
                </div>
            </div>

        </div>
        