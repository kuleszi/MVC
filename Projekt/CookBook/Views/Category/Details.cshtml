@model IEnumerable<CookBook.Models.Recipe>

@{

    ViewData["Title"] = ViewBag.CategoryName ?? "Kategoria";

    int index = 0;

}



<div class="container" style="width: 60vw; margin: 0 auto;">

    <h1 class="text-center mb-5 mt-4" ">@ViewData["Title"]</h1>

    <div class=" m-0 bg-light max-auto">
        <div class="recipes-list mt-4">

            @foreach (var recipe in Model)

            {

                bool isEven = index % 2 != 0;

                string textOrder = isEven ? "order-md-1" : "order-md-2";

                string imageOrder = isEven ? "order-md-2" : "order-md-1";

                <div class="row align-items-center p-0 g-0 bg-light overflow-hidden">
                    <div class="col-md-6 @textOrder d-flex flex-column justify-content-center align-items-center">
                        <div class="recipe-info-container mb-4 justify-content-center w-100">
                            <a asp-controller="Recipe" asp-action="Details" asp-route-id="@recipe.Id"
                               class="text-decoration-none text-center">
                                <div class="header-category bg-secondary" style="width: 100%">
                                    <h2 class="recipe-name mt-3">@recipe.Name</h2>

                                </div>

                            </a>

                        </div>
                        <div class="d-flex flex-wrap gap-4 mb-4 text-primary-emphasis text-center">

                            <div class="stat-item"><span class="text-dark me-1">⌚</span> @recipe.CookTime m</div>

                            <div class="stat-item"><span class="text-dark me-1">🔥</span> @recipe.Kcal kcal</div>

                            <div class="stat-item"><span class="text-dark me-1">🍽️</span> @recipe.Portion porcji</div>

                        </div>
                        <div class="recipe-description bg-secondary text-dark rounded shadow-lg p-2" style="width: 80%; ">
                            <p style="display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden;">@recipe.Description</p>

                        </div>
                    </div>
                    <div class="col-md-6 @imageOrder p-0">

                        <a asp-controller="Recipe" asp-action="Details" asp-route-id="@recipe.Id" class="d-flex justify-content-end">

                            <img src="/@recipe.Photo" alt="@recipe.Name" style="min-height: 100%; width:100%; object-fit: cover;" />

                        </a>

                    </div>



                </div>

                index++;

            }

        </div>

    </div>
</div>