@model ErrorViewModel
@{
    ViewData["Title"] = "Błąd";
}

<div class="container d-flex justify-content-center align-items-center my-5 py-5">
    
    <div class="modal-dialog w-100" style="max-width: 500px;" role="document">
        <div class="modal-content shadow">
            
           
            <div class="modal-header bg-light justify-content-center py-3">
                <h5 class="modal-title h4 fw-bold text-dark">Coś poszło nie tak...</h5>
            </div>
            
            
            <div class="modal-body text-center p-5">
                <h1 class="display-1 text-danger fw-bold mb-3">
                    @(Model.StatusCode.HasValue ? Model.StatusCode.Value.ToString() : "Błąd")
                </h1>
                <p class="lead text-muted">
                    @Model.Message
                </p>
                
                @if (Model.ShowRequestId)
                {
                    <p class="mt-4 small text-muted">
                        <code>ID żądania: @Model.RequestId</code>
                    </p>
                }
            </div>
            
            
            <div class="modal-footer justify-content-center bg-light py-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary px-4 py-2">
                    Wróć do Strony Głównej
                </a>
            </div>

        </div>
    </div>
</div>