<!DOCTYPE html>
<html lang="pl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CookBook</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootswatch/5.3.3/morph/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CookBook.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-light" data-bs-theme="light">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Strona główna</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor03"
                        aria-controls="navbarColor03" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarColor03">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Recipe" asp-action="Index">Wszystkie przepisy</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a asp-controller="Category" asp-action="Details" class="nav-link dropdown-toggle"
                               data-bs-toggle="dropdown" role="button" aria-haspopup="true"
                               aria-expanded="false">Kategorie</a>
                            <div class="dropdown-menu">
                                <a class="dropdown-item" asp-controller="Category" asp-action="Details"
                                   asp-route-name="Śniadania">Śniadania</a>
                                <a class="dropdown-item" asp-controller="Category" asp-action="Details"
                                   asp-route-name="Obiady">Obiady</a>
                                <a class="dropdown-item" asp-controller="Category" asp-action="Details"
                                   asp-route-name="Kolacje">Kolacje</a>
                                <a class="dropdown-item" asp-controller="Category" asp-action="Details"
                                   asp-route-name="Desery">Desery</a>
                            </div>
                        </li>
                    </ul>
                    <form class="d-flex position-relative">
                        <input id="searchBar" class="form-control me-sm-2" type="search" placeholder="Szukaj przepisów">
                        <button id="searchBtn" class="btn btn-secondary my-2 my-sm-0" type="submit">Szukaj</button>
                        <div id="searchResults" class="dropdown-menu w-100"
                             style="display: none; position: absolute; top: 100%; left: 0;"></div>
                    </form>
                    <ul class="navbar-nav ms-auto">
                        @if (!User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Zaloguj</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Register">Zarejestruj się</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Recipe" asp-action="MyRecipe">Moje przepisy</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Logout">Wyloguj się</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
    <footer class="navbar navbar-expand bg-light fixed-bottom mt-auto">
    <div class="container-fluid">
        <ul class="navbar-nav me-auto">
            <li class="nav-item">
                <a class="nav-link" asp-controller="Home" asp-action="Privacy">Polityka prywatności</a>
            </li>
        </ul>
        
        <span class="navbar-text">
            © 2026 Książka Kucharska
        </span>
    </div>
</footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
