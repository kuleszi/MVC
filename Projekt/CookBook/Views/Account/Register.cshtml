@model CookBook.Models.User

<div class="card">
    <div class="card-body">
        <form action="/Account/Register" method="post">
            <div class="col-md-8 mx-auto">
                <div class="row mb-3 first-row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" asp-for="UserName">Podaj nazwę użytkownika:</label>
                            <input class="form-control" asp-for="UserName" type="text"
                                   placeholder="Nazwa użytkownika" />
                            <span asp-validation-for="UserName" class="invalid-feedback d-block"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" asp-for="Name">Podaj swoje imię:</label>
                            <input class="form-control" asp-for="Name" type="text" placeholder="Imię" />
                            <span asp-validation-for="Name" class="invalid-feedback d-block"></span>
                        </div>
                    </div>
                </div>
                <div class="row mb-3 second-row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" asp-for="Password">Hasło
                            </label>
                            <input class="form-control" asp-for="Password" type="password" placeholder="Hasło" />
                            <small class="form-text text-muted">Hasło musi składać się z co najmniej 8 znaków, w tym 1
                                cyfry i 1 znaku specjalnego.</small>
                                <span asp-validation-for="Password" class="invalid-feedback d-block"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label" asp-for="Surname">Podaj swoje nazwisko:</label>
                                <input class="form-control" asp-for="Surname" type="text" placeholder="Nazwisko" />
                                <span asp-validation-for="Surname" class="invalid-feedback d-block"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-3 third-row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label" asp-for="Email">Podaj adres e-mail:</label>
                                <input class="form-control" asp-for="Email" type="email" placeholder="Adres e-mail" />
                                <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" asp-for="ConfirmEmail">Powtórz adres e-mail:</label>
                                <input class="form-control" asp-for="ConfirmEmail" type="email"
                                       placeholder="Adres e-mail" />
                                <span asp-validation-for="ConfirmEmail" class="invalid-feedback d-block"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label" asp-for="Birthday">Podaj swoją datę urodzenia:</label>
                                <input class="form-control is-invalid" asp-for="Birthday" type="date" />
                                <span asp-validation-for="Birthday" class="invalid-feedback d-block"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="text-center mt-4"> <button class="btn btn-success type=" submit">Zarejestruj się</button>
                </div>
            </form>
        </div>
    </div>
