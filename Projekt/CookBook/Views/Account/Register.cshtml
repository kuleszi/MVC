@model CookBook.Models.User

<form action="/Account/Register" method="post">
<div class="form-group">
    <label asp-for="UserName">Podaj nazwę użytkownika:</label>
    <input asp-for="UserName" type="text" placeholder="Nazwa użytkownika"/>
    <span asp-validation-for="UserName" class="text-danger" ></span>
</div>
<div class="form-group">
    <label asp-for="Password">Podaj hasło. Hasło musi składać się z conajmniej 8 zanków, w tym conajmniej 1 cyfra i jeden znak specjalny:</label>
    <input asp-for="Password" type="password" placeholder="Hasło"/>
    <span asp-validation-for="Password" class="text-danger" ></span>
</div>
<div class="form-group">
    <label asp-for="Email">Podaj adres e-mail:</label>
    <input asp-for="Email" type="email" placeholder="Adres e-mail"/>
    <span asp-validation-for="Email" class="text-danger" ></span>
</div>
<div class="form-group">
    <label asp-for="ConfirmEmail">Powtórz adres e-mail:</label>
    <input asp-for="ConfirmEmail" type="email" placeholder="Adres e-mail"/>
    <span asp-validation-for="ConfirmEmail" class="text-danger" ></span>
</div>
<div class="form-group">
    <label asp-for="Name">Podaj swoje imię:</label>
    <input asp-for="Name" type="text" placeholder="Imię"/>
    <span asp-validation-for="Name" class="text-danger" ></span>
</div>
<div class="form-group">
    <label asp-for="Surname">Podaj swoje nazwisko:</label>
    <input asp-for="Surname" type="text" placeholder="Nazwisko"/>
    <span asp-validation-for="Surname" class="text-danger" ></span>
</div>
<div class="form-group">
    <label asp-for="Birthday">Podaj swoją datę urodzenia:</label>
    <input asp-for="Birthday" type="date" />
    <span asp-validation-for="Birthday" class="text-danger" ></span>
</div>
<button type="submit">Zarejestruj się</button>
<div asp-validation-summary="All"></div>
</form>